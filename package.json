{
  "name": "1024soft",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build && node scripts/csp-hashes.mjs && node scripts/check-https.mjs && npm run search:index",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate-content.mjs",
    "check:https": "node scripts/check-https.mjs",
    "search:index": "pagefind --site dist --output-subdir _pagefind",
    "serve": "node scripts/serve-https.mjs",
    "serve:http": "npx --yes serve dist -l 4321",
    "seed": "node scripts/seed-content.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/preact": "^4.0.0",
    "preact": "^11.2.0",
    "octokit": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  },
  "devDependencies": {
    "pagefind": "^1.0.0",
    "zod": "^3.24.0",
    "gray-matter": "^4.0.3",
    "typescript": "^5.7.0",
    "@astrojs/check": "^0.9.0"
  }
}
